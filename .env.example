# Telegram
BOT_TOKEN=
# Forum group chat id (negative number, e.g. -100xxxxxxxxxx)
CHAT_ID=

# Forum topic thread ids — alert destinations only (not used for locks)
TOPIC_LAUNCHES=
TOPIC_DEVLOCK=
TOPIC_STAKING=
TOPIC_CLAIMS=

# Second bot — topic guard (runs with BOT_TOKEN in the same process)
# Create via @BotFather, add as admin with Delete messages. Leave blank to disable.
# Lock topics in the group with /lock (not via TOPIC_* below).
RESTRICT_BOT_TOKEN=
# Optional default for warning text until you set /allowhint in the group
RESTRICT_ALLOWED_HINT=
RESTRICT_NOTICE_TTL_MS=5000

# Backend
API_BASE_URL=http://127.0.0.1:8080

# Links on inline buttons
WEB_BASE_URL=https://lootingpad.com
# Optional: full prefix including trailing slash, e.g. https://explorer.example/tx/
EXPLORER_TX_BASE=
# Optional: token page on explorer, e.g. https://explorer.example/token/
EXPLORER_TOKEN_BASE=

# Poller
POLL_INTERVAL_MS=20000
# Notify stake/claim only when amount/reward >= this (UI units). 0 = all.
MIN_STAKE_NOTIFY=0
MIN_CLAIM_NOTIFY=0

# Optional: Telegram custom/premium emoji ids (Custom Emoji pack via @Stickers).
# Leave blank → plain Unicode fallback. Get id from message entities / @RawDataBot.
EMOJI_ROCKET=
EMOJI_GRADUATED=
EMOJI_LOCK=
EMOJI_UNLOCK=
EMOJI_VAULT=
EMOJI_STAKE=
EMOJI_GIFT=
EMOJI_STATS=
EMOJI_TOKEN=
EMOJI_TROPHY=
EMOJI_FIRE=
EMOJI_BOLT=
EMOJI_WARN=
EMOJI_GOLD=
EMOJI_SILVER=
EMOJI_BRONZE=
